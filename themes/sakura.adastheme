{
  "adasTheme": 1,
  "id": "sakura",
  "name": "Sakura",
  "author": "Adás – minta",
  "description": "Cseresznyevirág: világos rózsaszín, puha árnyékok, lehulló szirmok a sarokban.",
  "tone": "light",
  "base": "zen",
  "colors": {
    "bg": "#fbf4f6",
    "bg2": "#ffffff",
    "bg3": "#f1e2e7",
    "bg4": "#e8d3da",
    "line": "#e2c8d1",
    "text": "#4a3b40",
    "textStrong": "#2a1f23",
    "muted": "#8d7880",
    "accent": "#d6457a",
    "accent2": "#ef7aa4"
  },
  "fonts": {
    "body": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
    "headings": "Georgia, 'Times New Roman', serif"
  },
  "radius": "14px",
  "background": "radial-gradient(ellipse at 85% 0%, #ffe1ec, transparent 55%), radial-gradient(ellipse at 0% 100%, #fde9ef, transparent 50%), #fbf4f6",
  "preview": [
    "#fbf4f6",
    "#d6457a",
    "#f1e2e7"
  ],
  "css": "/* kártyák és csempék: puha rózsaszín árnyék */\n.dcard { border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 10px 30px rgba(214, 69, 122, 0.12); }\n.dc-title { color: var(--accent); }\n.thumb, .vposter { border-radius: 14px; box-shadow: 0 6px 18px rgba(214, 69, 122, 0.15); }\n.card:hover .thumb, .card:focus-visible .thumb { box-shadow: 0 0 0 3px var(--accent), 0 10px 24px rgba(214, 69, 122, 0.3); }\n.btn.primary, .btn.white { background: var(--accent); color: #fff; border-radius: 30px; }\n.tab.active { background: var(--accent); color: #fff; }\n.now-label, .live-badge { background: var(--accent); }\n/* szirmok a jobb felső sarokban (díszítés, nem kattintható) */\n&::after { content: \"\"; position: fixed; right: 18px; top: 74px; width: 120px; height: 120px; pointer-events: none; z-index: 0; opacity: 0.55;\n  background: radial-gradient(ellipse 9px 5px at 20% 30%, #f7a8c4 98%, transparent), radial-gradient(ellipse 7px 4px at 70% 20%, #f4b8cd 98%, transparent), radial-gradient(ellipse 8px 5px at 50% 70%, #f7a8c4 98%, transparent), radial-gradient(ellipse 6px 4px at 85% 60%, #f9c7d8 98%, transparent);\n  animation: sakura-sway 6s ease-in-out infinite alternate; }\n@keyframes sakura-sway { from { transform: rotate(-4deg); } to { transform: rotate(4deg) translateY(6px); } }\n&.tv::after { animation: none; }"
}