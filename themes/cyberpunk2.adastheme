{
  "adasTheme": 1,
  "id": "cyberpunk",
  "name": "Cyberpunk",
  "description": "Éjszakai neonváros: cián, magenta és borostyán jelzések, vágott sarkok, mozgó digitális rács és finom scanline-fény.",
  "author": "Adás",
  "tone": "dark",
  "base": "cyberpunk",
  "colors": {
    "bg": "#070812",
    "bg2": "#101225",
    "bg3": "#171a31",
    "bg4": "#232442",
    "line": "#3b4370",
    "text": "#dce8ff",
    "textStrong": "#ffffff",
    "muted": "#939bc8",
    "accent": "#00e5ff",
    "accent2": "#ff3fd2"
  },
  "fonts": {
    "body": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
    "headings": "'Arial Black', 'Segoe UI Semibold', 'Segoe UI', Arial, sans-serif"
  },
  "radius": "8px",
  "background": "radial-gradient(ellipse at 18% 0%, rgba(0,229,255,.14), transparent 42%), radial-gradient(ellipse at 100% 100%, rgba(255,63,210,.15), transparent 45%), linear-gradient(180deg,#070812,#090713 56%,#120b1d 100%)",
  "preview": [
    "#070812",
    "#00e5ff",
    "#171a31"
  ],
  "css": "& { --cy-cyan:#00e5ff; --cy-pink:#ff3fd2; --cy-yellow:#ffe66d; --cy-black:#070812; --danger:#d11f45; }\n& .dcard, & .modal, & .set-section, & .card .thumb, & .vposter, & .tile { background:linear-gradient(180deg,rgba(23,26,49,.94),rgba(16,18,37,.96)); border:1px solid rgba(0,229,255,.36); box-shadow:0 0 0 1px rgba(255,63,210,.12) inset,0 0 18px rgba(0,229,255,.095),0 0 30px rgba(255,63,210,.07); clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px); }\n& .brand, & .dc-title, & .row-title, & .hero h1 { color:#ffffff; text-transform:uppercase; letter-spacing:.065em; text-shadow:0 0 9px rgba(0,229,255,.34),0 0 22px rgba(255,63,210,.18); }\n& .links a.active { background:var(--cy-cyan); color:var(--cy-black); border:1px solid var(--cy-cyan); font-weight:900; text-shadow:none; box-shadow:0 0 18px rgba(0,229,255,.25); }\n& .tab.active { background:var(--cy-pink); color:var(--cy-black); border:1px solid var(--cy-pink); font-weight:900; text-shadow:none; box-shadow:0 0 18px rgba(255,63,210,.22); }\n& .btn { border:1px solid #4b558a; font-weight:850; text-transform:uppercase; letter-spacing:.045em; }\n& .btn.primary { background:linear-gradient(90deg,var(--cy-cyan),var(--cy-pink)); color:var(--cy-black); border-color:rgba(255,255,255,.22); text-shadow:none; box-shadow:0 0 17px rgba(0,229,255,.18),0 0 24px rgba(255,63,210,.12); }\n& .btn.white { background:#eef4ff; color:#101225; border-color:#eef4ff; text-shadow:none; }\n& .btn.gray { background:#232442; color:#eef4ff; border-color:#59629a; text-shadow:none; }\n& .btn.danger { background:var(--danger); color:#ffffff; border-color:#ff4d70; text-shadow:none; }\n& .input, & select { background:#101225; color:#dce8ff; border:1px solid #505a91; box-shadow:inset 0 0 0 1px rgba(0,229,255,.035); }\n& .live-badge, & .now-label { background:var(--cy-yellow); color:var(--cy-black); border:1px solid #d6be45; font-weight:950; text-shadow:none; box-shadow:0 0 13px rgba(255,230,109,.18); }\n& .bar { background:#222746; border:1px solid #3b4370; } & .bar i { background:linear-gradient(90deg,var(--cy-cyan),var(--cy-pink)); }\n& .card:hover .thumb, & .vcard:hover .vposter, & .tile:hover { box-shadow:0 0 0 2px var(--cy-cyan),0 0 23px rgba(0,229,255,.20),0 0 34px rgba(255,63,210,.15); filter:saturate(1.10) brightness(1.045); }\n& :focus-visible { outline:4px solid var(--cy-pink); outline-offset:3px; box-shadow:0 0 0 2px var(--cy-cyan),0 0 20px rgba(0,229,255,.24); }\n&::before { content:''; position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.25; background:linear-gradient(rgba(0,229,255,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(255,63,210,.065) 1px,transparent 1px); background-size:36px 36px; animation: cyber-grid 10s linear infinite; mix-blend-mode:screen; }\n&::after { content:''; position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.13; background:repeating-linear-gradient(180deg,rgba(255,255,255,.035) 0 1px,transparent 1px 4px),linear-gradient(90deg,transparent 0 44%,rgba(0,229,255,.10) 49%,rgba(255,255,255,.15) 50%,rgba(255,63,210,.10) 51%,transparent 56%); background-size:auto,220% 100%; animation: cyber-scan 6.8s ease-in-out infinite; }\n@keyframes cyber-grid { from { background-position:0 0,0 0; } to { background-position:36px 36px,-36px 36px; } }\n@keyframes cyber-scan { 0%,100% { background-position:0 0,-120% 0; opacity:.08; } 45%,55% { opacity:.18; } 50% { background-position:0 0,120% 0; } }\n&.tv::before, &.tv::after { animation:none; opacity:.06; }"
}
