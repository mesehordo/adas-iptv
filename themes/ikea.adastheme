{
  "adasTheme": 1,
  "id": "ikea",
  "name": "IKEA",
  "description": "Skandináv katalógushangulat: tiszta fehér felületek, IKEA-kék és sárga, geometrikus blokkok és lassan mozgó grafikai sávok.",
  "author": "Adás",
  "tone": "light",
  "base": "bauhaus",
  "colors": {
    "bg": "#f4f6f7",
    "bg2": "#ffffff",
    "bg3": "#e9eef3",
    "bg4": "#dfe6ec",
    "line": "#bbc6d1",
    "text": "#263442",
    "textStrong": "#111820",
    "muted": "#5d6872",
    "accent": "#0058a3",
    "accent2": "#ffda1a"
  },
  "fonts": {
    "body": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
    "headings": "'Arial Black', 'Segoe UI Semibold', Arial, sans-serif"
  },
  "radius": "2px",
  "background": "linear-gradient(180deg, rgba(0,88,163,.035), transparent 34%), #f4f6f7",
  "preview": [
    "#f4f6f7",
    "#0058a3",
    "#ffda1a"
  ],
  "css": "& { --ikea-blue:#0058a3; --ikea-yellow:#ffda1a; --ikea-ink:#111820; --danger:#b4232d; }\n& #nav, & .dcard, & .modal, & .set-section, & .tile { background:#ffffff; border:1px solid var(--line); box-shadow:0 7px 20px rgba(17,24,32,.065); }\n& .brand, & .dc-title, & .row-title, & .hero h1 { color:var(--ikea-blue); font-weight:900; letter-spacing:-.015em; text-transform:uppercase; }\n& .links a.active { background:var(--ikea-blue); color:#ffffff; border:1px solid var(--ikea-blue); font-weight:800; box-shadow:inset 0 -3px 0 var(--ikea-yellow); }\n& .tab.active { background:var(--ikea-yellow); color:var(--ikea-ink); border:1px solid #d5b500; font-weight:900; }\n& .btn { border:1px solid var(--line); font-weight:800; box-shadow:none; }\n& .btn.primary { background:var(--ikea-blue); color:#ffffff; border-color:var(--ikea-blue); }\n& .btn.white { background:#ffffff; color:#111820; border-color:#aebbc7; }\n& .btn.gray { background:#e9eef3; color:#1f2a34; border-color:#b9c3cd; }\n& .btn.danger { background:var(--danger); color:#ffffff; border-color:var(--danger); }\n& .input, & select { background:#ffffff; color:#263442; border:1px solid #aebbc7; box-shadow:inset 0 0 0 1px rgba(0,88,163,.025); }\n& .live-badge, & .now-label { background:var(--ikea-yellow); color:var(--ikea-ink); border:1px solid #d5b500; font-weight:900; }\n& .bar { background:#d9e0e6; } & .bar i { background:var(--ikea-blue); }\n& .card:hover .thumb, & .vcard:hover .vposter, & .tile:hover { filter:brightness(1.018) saturate(1.035); box-shadow:0 0 0 3px var(--ikea-blue), 0 9px 18px rgba(17,24,32,.10); }\n& :focus-visible { outline:4px solid var(--ikea-yellow); outline-offset:3px; box-shadow:0 0 0 2px var(--ikea-blue); }\n&::before { content:''; position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.17; background:linear-gradient(115deg, transparent 0 38%, rgba(0,88,163,.16) 38% 42%, transparent 42% 68%, rgba(255,218,26,.22) 68% 73%, transparent 73% 100%); background-size:280px 280px; animation: ikea-catalog-slide 18s linear infinite; }\n&::after { content:''; position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.20; background:radial-gradient(circle at 86% 15%, rgba(255,218,26,.30), transparent 14%), radial-gradient(circle at 12% 82%, rgba(0,88,163,.16), transparent 16%); animation: ikea-soft-pulse 8s ease-in-out infinite; }\n@keyframes ikea-catalog-slide { from { background-position:0 0; } to { background-position:280px 0; } }\n@keyframes ikea-soft-pulse { 0%,100% { opacity:.14; filter:saturate(.95); } 50% { opacity:.28; filter:saturate(1.08); } }\n&.tv::before, &.tv::after { animation:none; opacity:.07; }"
}
