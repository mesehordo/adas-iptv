{
  "adasTheme": 1,
  "id": "snes",
  "name": "SNES Controller Color",
  "description": "Színes SNES/Super Famicom kontroller ihletésű világos retro téma: konzolszürke műanyag, piros-zöld-kék-sárga gombmotívumok és tiszta, olvasható felület.",
  "author": "Adás",
  "tone": "light",
  "base": "snes",
  "colors": {
    "bg": "#e8e7eb",
    "bg2": "#f8f8fb",
    "bg3": "#e4e3e8",
    "bg4": "#d4d3da",
    "line": "#8e9099",
    "text": "#40424a",
    "textStrong": "#24262c",
    "muted": "#6f727b",
    "accent": "#2f6fbe",
    "accent2": "#f0c854"
  },
  "fonts": {
    "body": "'Segoe UI', 'Trebuchet MS', Arial, sans-serif",
    "headings": "'Arial Black', 'Trebuchet MS', 'Segoe UI', sans-serif"
  },
  "radius": "14px",
  "background": "radial-gradient(ellipse at 20% 0%, rgba(255,255,255,.68), transparent 44%), linear-gradient(180deg, #f0f0f4 0%, #e8e7eb 100%)",
  "preview": [
    "#e8e7eb",
    "#2f6fbe",
    "#f8f8fb"
  ],
  "css": "@keyframes snes-button-breathe { 0%,100% { box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 2px 0 rgba(64,66,74,.18), 0 0 0 0 rgba(47,111,190,.10); } 50% { box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 2px 0 rgba(64,66,74,.18), 0 0 0 4px rgba(47,111,190,.08); } }\n@keyframes snes-focus-pulse { 0%,100% { box-shadow: 0 0 0 3px rgba(240,200,84,.36), 0 3px 0 rgba(64,66,74,.18); } 50% { box-shadow: 0 0 0 5px rgba(240,200,84,.18), 0 3px 0 rgba(64,66,74,.18); } }\n@keyframes snes-dpad-nudge { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-1px); } }\n& .dcard, & .modal, & .set-section, & .card .thumb, & .vposter, & .tile { background: linear-gradient(180deg, #fcfcfe, #f1f1f5); border: 1px solid #b7b8c1; border-radius: 14px; box-shadow: inset 0 1px 0 rgba(255,255,255,.94), 0 3px 0 rgba(64,66,74,.16), 0 10px 20px rgba(64,66,74,.08); }\n& #nav, & .hero, & .dcard, & .modal { position: relative; }\n& .brand, & .dc-title, & .row-title, & .hero h1 { color: var(--text-strong); font-weight: 900; letter-spacing: .03em; text-transform: uppercase; }\n& .links a { color: var(--text); }\n& .links a.active, & .tab.active { background: linear-gradient(180deg, #4a88d2, var(--accent)); color: #ffffff; border: 1px solid #225594; border-radius: 999px; box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 2px 0 rgba(64,66,74,.20); font-weight: 800; }\n& .dc-link { color: var(--accent); font-weight: 800; text-decoration: underline; text-decoration-thickness: 2px; }\n& .btn { border-radius: 999px; font-weight: 800; }\n& .btn.primary { background: linear-gradient(180deg, #4a88d2, var(--accent)); color: #ffffff; border: 1px solid #225594; box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 2px 0 rgba(64,66,74,.22); animation: snes-button-breathe 2.8s ease-in-out infinite; }\n& .btn.white { background: linear-gradient(180deg, #ffffff, #efeff3); color: var(--text-strong); border: 1px solid #b7b8c1; box-shadow: inset 0 1px 0 rgba(255,255,255,.96), 0 2px 0 rgba(64,66,74,.14); }\n& .btn.gray, & .tab, & .input, & select { background: linear-gradient(180deg, #ebecef, #dedfe5); color: var(--text-strong); border: 1px solid #a9acb6; box-shadow: inset 0 1px 0 rgba(255,255,255,.88), 0 2px 0 rgba(64,66,74,.12); }\n& .btn.danger { background: linear-gradient(180deg, #d05263, #b9394b); color: #ffffff; border: 1px solid #8b2434; box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 2px 0 rgba(64,66,74,.20); }\n& .live-badge, & .now-label { background: linear-gradient(180deg, #f8d973, var(--accent2)); color: #473816; border: 1px solid #b18d29; border-radius: 999px; font-weight: 900; box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 2px 0 rgba(64,66,74,.14); }\n& .switch:checked, & .bar i { background: linear-gradient(180deg, #4a88d2, var(--accent)); }\n& .input, & select { border-radius: 10px; }\n& .card:hover .thumb, & .vcard:hover .vposter, & .tile:hover { border-color: #7ea7dc; box-shadow: 0 0 0 3px rgba(240,200,84,.45), inset 0 1px 0 rgba(255,255,255,.94), 0 3px 0 rgba(64,66,74,.16), 0 10px 20px rgba(64,66,74,.08); animation: snes-dpad-nudge .7s steps(2,end) infinite; }\n& :focus-visible { outline: 4px solid var(--accent2); outline-offset: 3px; border-radius: 14px; animation: snes-focus-pulse 1.25s steps(2,end) infinite; }\n& #nav::before { content: ''; position: absolute; right: 18px; top: 12px; width: 54px; height: 16px; pointer-events: none; border-radius: 999px; background: radial-gradient(circle at 8px 8px, #cf4a63 0 4px, transparent 4.5px), radial-gradient(circle at 22px 8px, #59a84b 0 4px, transparent 4.5px), radial-gradient(circle at 36px 8px, #4180cf 0 4px, transparent 4.5px), radial-gradient(circle at 50px 8px, #f0c854 0 4px, transparent 4.5px); opacity: .82; }\n& .dcard::before, & .modal::before { content: ''; position: absolute; left: 16px; top: 14px; width: 22px; height: 22px; pointer-events: none; opacity: .13; background: linear-gradient(90deg, transparent 7px, #3f4048 7px 15px, transparent 15px), linear-gradient(transparent 7px, #3f4048 7px 15px, transparent 15px); }\n&::before { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: .10; background: linear-gradient(90deg, rgba(64,66,74,.04) 1px, transparent 1px), linear-gradient(rgba(64,66,74,.03) 1px, transparent 1px); background-size: 14px 14px; }\n&::after { content: 'SUPER 16-BIT'; position: fixed; right: 16px; bottom: 12px; pointer-events: none; z-index: 0; color: rgba(47,111,190,.16); font-weight: 900; letter-spacing: .08em; }\n&.tv .btn.primary, &.tv .card:hover .thumb, &.tv .vcard:hover .vposter, &.tv .tile:hover, &.tv :focus-visible { animation: none; }\n&.tv::before { opacity: .06; }"
}
