{
  "adasTheme": 1,
  "id": "oko",
  "name": "Öko",
  "description": "Természetközeli, papír- és levélhangulat: mohazöld, agyagbarna, organikus foltok és nagyon lassú lélegző háttérmozgás.",
  "author": "Adás",
  "tone": "light",
  "base": "wabisabi",
  "colors": {
    "bg": "#efeade",
    "bg2": "#faf7ef",
    "bg3": "#dfe8d8",
    "bg4": "#ccd9c5",
    "line": "#a9b5a3",
    "text": "#354038",
    "textStrong": "#18231a",
    "muted": "#66736a",
    "accent": "#466c3b",
    "accent2": "#9a5f32"
  },
  "fonts": {
    "body": "Georgia, 'Segoe UI', serif",
    "headings": "Georgia, 'Times New Roman', serif"
  },
  "radius": "16px",
  "background": "radial-gradient(ellipse at 18% 0%, rgba(70,108,59,.13), transparent 45%), radial-gradient(ellipse at 100% 86%, rgba(154,95,50,.09), transparent 42%), #efeade",
  "preview": [
    "#efeade",
    "#466c3b",
    "#dfe8d8"
  ],
  "css": "& { --oko-green:#466c3b; --oko-clay:#9a5f32; --oko-paper:#faf7ef; --danger:#a12a32; }\n& .dcard, & .modal, & .set-section, & .tile, & .card .thumb, & .vposter { background:rgba(250,247,239,.93); border:1px solid var(--line); box-shadow:0 8px 24px rgba(53,64,56,.08); }\n& .dc-title, & .row-title, & .hero h1, & .brand { color:var(--text-strong); font-weight:700; letter-spacing:.004em; text-shadow:0 1px 0 rgba(255,255,255,.72); }\n& .links a.active { background:var(--oko-green); color:#ffffff; border:1px solid var(--oko-green); font-weight:800; }\n& .tab.active { background:var(--oko-clay); color:#ffffff; border:1px solid #7d4c28; font-weight:800; }\n& .btn { border:1px solid var(--line); font-weight:700; box-shadow:none; }\n& .btn.primary { background:var(--oko-green); color:#ffffff; border-color:var(--oko-green); }\n& .btn.white { background:#fffdf8; color:#243027; border-color:#a9b5a3; }\n& .btn.gray { background:#dfe8d8; color:#253229; border-color:#a9b5a3; }\n& .btn.danger { background:var(--danger); color:#ffffff; border-color:var(--danger); }\n& .input, & select { background:#fffdf8; color:#354038; border:1px solid #98a591; box-shadow:inset 0 0 0 1px rgba(70,108,59,.025); }\n& .live-badge, & .now-label { background:var(--oko-clay); color:#ffffff; border:1px solid #7d4c28; font-weight:800; }\n& .bar { background:#d2dccb; border:1px solid #a9b5a3; } & .bar i { background:var(--oko-green); }\n& .card:hover .thumb, & .vcard:hover .vposter, & .tile:hover { filter:saturate(.96) brightness(1.018); box-shadow:0 0 0 2px var(--oko-green), 0 10px 26px rgba(53,64,56,.11); transform:rotate(.25deg); }\n& :focus-visible { outline:4px solid var(--oko-clay); outline-offset:3px; box-shadow:0 0 0 2px #fffdf8; }\n&::before { content:''; position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.19; background:radial-gradient(ellipse at 18% 20%, rgba(70,108,59,.18) 0 2px, transparent 2.7px), radial-gradient(ellipse at 78% 70%, rgba(154,95,50,.12) 0 1.5px, transparent 2.3px); background-size:38px 32px, 51px 44px; animation: oko-breathe 14s ease-in-out infinite; transform-origin:center; }\n&::after { content:'❧'; position:fixed; right:4vw; bottom:5vh; pointer-events:none; z-index:0; color:rgba(70,108,59,.075); font-family:Georgia,serif; font-size:clamp(56px,10vw,170px); transform:rotate(-8deg); animation: oko-leaf-sway 11s ease-in-out infinite; }\n@keyframes oko-breathe { 0%,100% { opacity:.13; transform:scale(1) rotate(0deg); } 50% { opacity:.23; transform:scale(1.012) rotate(.35deg); } }\n@keyframes oko-leaf-sway { 0%,100% { transform:rotate(-8deg) translateY(0); opacity:.55; } 50% { transform:rotate(-4deg) translateY(-6px); opacity:1; } }\n&.tv::before, &.tv::after { animation:none; opacity:.055; }"
}
