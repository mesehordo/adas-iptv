{
  "adasTheme": 1,
  "id": "snes",
  "name": "SNES Retro",
  "description": "Letisztult 16-bites SNES-hangulat klasszikus konzolszürkével, lila kiemelésekkel, pixeles keretekkel és visszafogott retro animációkkal.",
  "author": "Adás",
  "tone": "light",
  "base": "snes",
  "colors": {
    "bg": "#ECEBF0",
    "bg2": "#FFFFFF",
    "bg3": "#E2DFEA",
    "bg4": "#D4D0DF",
    "line": "#6E6785",
    "text": "#3A3647",
    "textStrong": "#29263A",
    "muted": "#6A6578",
    "accent": "#5A4A8C",
    "accent2": "#E8C54A"
  },
  "fonts": {
    "body": "'Trebuchet MS', 'Segoe UI', Arial, sans-serif",
    "headings": "'Courier New', 'Lucida Console', monospace"
  },
  "radius": "0px",
  "background": "linear-gradient(180deg, rgba(255,255,255,.55), rgba(236,235,240,.72)), repeating-linear-gradient(90deg, rgba(90,74,140,.035) 0 2px, transparent 2px 10px), #ECEBF0",
  "preview": [
    "#ECEBF0",
    "#5A4A8C",
    "#FFFFFF"
  ],
  "css": "@keyframes snes-focus-pulse { 0%,100% { box-shadow: 0 0 0 3px rgba(232,197,74,.28), 3px 3px 0 rgba(41,38,58,.22); } 50% { box-shadow: 0 0 0 5px rgba(232,197,74,.18), 3px 3px 0 rgba(41,38,58,.22); } }\n@keyframes snes-pixel-nudge { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-1px); } }\n& .dcard, & .modal, & .set-section, & .card .thumb, & .vposter, & .tile { background: var(--bg2); border: 2px solid var(--line); box-shadow: 3px 3px 0 rgba(41,38,58,.20); border-radius: 0; }\n& .brand, & .dc-title, & .row-title, & .hero h1 { color: var(--text-strong); font-family: 'Courier New', 'Lucida Console', monospace; font-weight: 900; letter-spacing: .03em; text-shadow: 1px 1px 0 #ffffff; }\n& .links a { color: var(--text); }\n& .links a.active, & .tab.active { background: var(--accent); color: #ffffff; border: 2px solid #3E3269; box-shadow: 2px 2px 0 rgba(41,38,58,.25); font-weight: 900; }\n& .dc-link { color: var(--accent); font-weight: 900; text-decoration: underline; text-decoration-thickness: 2px; }\n& .btn { font-weight: 800; border-radius: 0; }\n& .btn.primary { background: var(--accent); color: #ffffff; border: 2px solid #3E3269; box-shadow: 2px 2px 0 rgba(41,38,58,.28); }\n& .btn.white { background: #ffffff; color: var(--text-strong); border: 2px solid var(--line); box-shadow: 2px 2px 0 rgba(41,38,58,.16); }\n& .btn.gray { background: #D9D6E2; color: var(--text-strong); border: 2px solid #8B849F; box-shadow: 2px 2px 0 rgba(41,38,58,.16); }\n& .btn.danger { background: #B93649; color: #ffffff; border: 2px solid #7E2434; box-shadow: 2px 2px 0 rgba(41,38,58,.22); }\n& .live-badge, & .now-label { background: var(--accent2); color: var(--text-strong); border: 2px solid #A8871D; font-weight: 900; box-shadow: 2px 2px 0 rgba(41,38,58,.18); }\n& .switch:checked, & .bar i { background: var(--accent); }\n& .input, & select { background: #ffffff; color: var(--text-strong); border: 2px solid var(--line); border-radius: 0; box-shadow: inset 0 0 0 1px rgba(90,74,140,.05); }\n& .card:hover .thumb, & .vcard:hover .vposter, & .tile:hover { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent2), 3px 3px 0 rgba(41,38,58,.22); animation: snes-pixel-nudge .7s steps(2,end) infinite; filter: saturate(1.03); }\n& :focus-visible { outline: 4px solid var(--accent2); outline-offset: 3px; animation: snes-focus-pulse 1.25s steps(2,end) infinite; }\n&::before { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: .22; background: linear-gradient(90deg, rgba(90,74,140,.07) 25%, transparent 25% 50%, rgba(232,197,74,.07) 50% 75%, transparent 75%), linear-gradient(rgba(41,38,58,.035) 1px, transparent 1px); background-size: 16px 16px, 100% 4px; }\n&::after { content: '16-BIT'; position: fixed; right: 18px; bottom: 14px; pointer-events: none; z-index: 0; color: rgba(90,74,140,.20); font-family: 'Courier New', monospace; font-weight: 900; letter-spacing: .08em; text-shadow: 1px 1px 0 rgba(255,255,255,.55); }\n&.tv .card:hover .thumb, &.tv .vcard:hover .vposter, &.tv .tile:hover, &.tv :focus-visible { animation: none; }\n&.tv::before { opacity: .10; }"
}
