{
  "name": "adas",
  "productName": "ADAS",
  "version": "1.35.1",
  "description": "Élő TV lejátszó az iptv-org nyilvános csatornalistájához, streaming-szolgáltatás stílusú felülettel.",
  "main": "main.js",
  "author": "ADAS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tools/run-tests.mjs",
    "start:nosandbox": "electron . --no-sandbox",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable msi",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:linux:any": "electron-builder --linux dir && node tools/build-linux.mjs",
    "dist:mac:any": "electron-builder --linux dir && node tools/build-mac.mjs",
    "android": "node tools/build-android.mjs",
    "android:mobile": "node tools/build-android.mjs --target=mobile",
    "android:tv": "node tools/build-android.mjs --target=tv",
    "ffmpeg": "node tools/fetch-ffmpeg.mjs",
    "linux-tools": "node tools/fetch-linux-tools.mjs",
    "android-deps": "node tools/fetch-android-deps.mjs",
    "i18n:check": "node tools/i18n-check.mjs"
  },
  "dependencies": {
    "dashjs": "^5.2.1",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.7.3"
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.2.6",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "hu.adas.tv",
    "productName": "ADAS",
    "afterPack": "build/mac-adhoc.js",
    "files": [
      "main.js",
      "preload.js",
      "lan.js",
      "updater.js",
      "media.js",
      "i18n-main.js",
      "covers.js",
      "icy.js",
      "stdio-guard.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "msi"
      ],
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "ffmpeg"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "ADAS-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin-${arch}",
          "to": "ffmpeg"
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/linux-x64",
          "to": "ffmpeg"
        }
      ],
      "icon": "assets/icon.png",
      "maintainer": "ADAS <noreply@example.com>",
      "synopsis": "Élő TV lejátszó",
      "desktop": {
        "entry": {
          "Name": "ADAS",
          "Comment": "Élő TV lejátszó",
          "Keywords": "tv;iptv;élő;televízió;műsor;"
        }
      }
    },
    "nsis": {
      "artifactName": "ADAS-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "ADAS-${version}-portable.${ext}"
    },
    "msi": {
      "artifactName": "ADAS-${version}.${ext}",
      "oneClick": false,
      "runAfterFinish": false,
      "additionalLightArgs": ["-cultures:hu-HU"]
    },
    "msiProjectCreated": "build/msi-hook.js",
    "dmg": {
      "artifactName": "ADAS-${version}-mac-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "ADAS_${version}_${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "ADAS-${version}-${arch}.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ]
    }
  }
}
